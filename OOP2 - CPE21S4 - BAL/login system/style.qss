QWidget {
    background-color: #f1f5f9;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    color: #1e293b;
}

QLineEdit, QComboBox {
    background-color: white;
    border: 2px solid #93b8e4;
    border-radius: 8px;
    padding: 8px;
    color: #1e293b;
}

QComboBox QAbstractItemView {
    background-color: white;
    color: #1e293b;
    selection-background-color: #81a1ca;
    selection-color: white;
}

QPushButton {
    border: none;
    border-radius: 8px;
    padding: 10px;
    font-weight: bold;
    background-color: #81a1ca;  
}   

#title { font-size: 24px; font-weight: bold; color: #00ddff; }
#subtitle { font-size: 12px; color: #64748b; }
#status { font-weight: bold;}
#loginBtn { background-color: #00ddff; color: white;}
#clearBtn { background-color: #e2e8f0; color: #334155;}

QLineEdit:hover, QComboBox:hover { border-color: #93c5fd; }
QLineEdit:focus, QComboBox:focus { border-color: #00f7ff; }

QLineEdit[error="true"] {
    border-color: #dc2626;
    background-color: #fef2f2;
}

#status[state="error"] { color: #dc2626; }
#status[state="success"] { color: #16a34a; }

#loginBtn:hover { background-color: #1d4ed8; }
#loginBtn:pressed { background-color: #1e40af; }
#clearBtn:hover { background-color: #cbd5e1; }
#clearBtn:pressed { background-color: #94a3b8; }

QCheckBox:hover {color: #1d8ad8;}
QCheckBox {color: #101010;}
QCheckBox:checked{color: #1d8ad8;}
QCheckBox:unchecked{color: #101010;}
QCheckBox::indicator:unchecked:hover {
    border: 1px solid #1e90ff;
    background-color: #e6f2ff;
}
