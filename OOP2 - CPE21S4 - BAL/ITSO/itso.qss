QWidget#ITSODashboard {
    background-color: #f1f5f9;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #0f172a;
}

QLabel#pageTitle {
    font-size: 22px;
    font-weight: bold;
    color: #0f172a;
}

QLabel#pageSubtitle {
    font-size: 12px;
    color: #475569;
}

QLabel#sectionLabel {
    font-weight: bold;
    color: #0f172a;
}

QTableWidget {
    background-color: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    color: #0f172a;
}

QHeaderView::section {
    background-color: #142856;
    color: white;
    font-weight: bold;
    padding: 6px;
    border: none;
}

QPushButton#refreshBtn {
    background-color: #0284c7;
    color: white;
    font-weight: bold;
    border-radius: 6px;
    padding: 8px 16px;
    border: none;
}

QPushButton#refreshBtn:hover {
    background-color: #0369a1;
}
