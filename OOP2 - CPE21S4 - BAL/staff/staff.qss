/* Custom industrial styling for stockroom physical inventory operations manager */
QWidget#StaffDashboard {
    background-color: #f8fafc;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #334155;
}

QLabel#pageTitle {
    font-size: 22px;
    font-weight: bold;
    color: #1e293b;
}

QLabel#pageSubtitle {
    font-size: 12px;
    color: #64748b;
}

QLabel#sectionLabel {
    font-weight: bold;
    color: #1e293b;
}

QLineEdit, QSpinBox {
    background-color: white;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px;
    color: #334155;
}

QLineEdit:focus, QSpinBox:focus {
    border: 1px solid #10b981;
}

QPushButton#addStockBtn {
    background-color: #10b981;
    color: white;
    font-weight: bold;
    border-radius: 6px;
    padding: 8px;
    border: none;
}

QPushButton#addStockBtn:hover {
    background-color: #059669;
}

QPushButton#releaseBtn {
    background-color: #6366f1;
    color: white;
    font-weight: bold;
    border-radius: 6px;
    padding: 10px;
    border: none;
}

QPushButton#releaseBtn:hover {
    background-color: #4f46e5;
}

QTableWidget {
    background-color: white;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    color: #334155;
}

QHeaderView::section {
    background-color: #475569;
    color: white;
    font-weight: 600;
    padding: 5px;
    border: none;
}
