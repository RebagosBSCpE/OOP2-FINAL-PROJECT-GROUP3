/* sets the white background color and text look for the professor dashboard canvas */
QWidget {
    background-color: #ffffff;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #1e293b;
}

/* changes the text size and sets the primary main title text color */
QLabel {
    font-size: 20px;
    font-weight: bold;
    color: #1e293b;
}

/* makes the sub-text under the main title smaller and shows a gray color */
QLabel {
    font-size: 12px;
    color: #64748b;
}

/* makes section labels bold to stand out from normal text */
QLabel {
    font-weight: bold;
    color: #1e293b;
    margin-top: 5px;
}

/* sets standard styling for text inputs line boxes and text areas */
QLineEdit, QTextEdit {
    background-color: white;
    border: 2px solid #93b8e4;
    border-radius: 8px;
    padding: 6px;
    color: #1e293b;
}

/* changes the border color when clicking or typing inside an input box */
QLineEdit:focus, QTextEdit:focus {
    border-color: #00f7ff;
}

/* sets styles for the table grid background and its outer borders */
QTableWidget {
    background-color: white;
    border: 2px solid #93b8e4;
    border-radius: 8px;
    color: #1e293b;
}

/* sets a gray background color and light text look for table row headers */
QHeaderView::section {
    background-color: #334155;
    color: white;
    font-weight: 600;
    padding: 6px;
    border: none;
}

/* styles the approve button with a blue background color */
QPushButton, QPushButton {
    background-color: #2449a4;
    color: white;
    font-weight: bold;
    border-radius: 8px;
    padding: 10px;
    border: none;
}

/* darkens the blue color when you hover over the approve button */
QPushButton:hover, QPushButton:hover {
    background-color: #1b3986;
}

/* styles the decline button with a red background color */
QPushButton {
    background-color: #b93838;
    color: white;
    font-weight: bold;
    border-radius: 8px;
    padding: 10px;
    border: none;
}

/* darkens the red color when you hover over the decline button */
QPushButton:hover {
    background-color: #962b2b;
}