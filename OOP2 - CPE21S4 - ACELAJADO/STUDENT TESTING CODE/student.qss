QWidget#StudentDashboard {
    background-color: #f8fafc;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #1e293b;
}

/* changes the text size and sets the primary main title text color to TIP Gold */
QLabel#pageTitle {
    font-size: 20px;
    font-weight: bold;
    color: #eab308;
}

/* makes the sub-text under the main title smaller and shows a dark charcoal color */
QLabel#pageSubtitle {
    font-size: 12px;
    color: #334155;
}

/* makes section labels bold in dark slate/charcoal */
QLabel#sectionLabel, QLabel#boldSectionLabel {
    font-weight: bold;
    color: #1e293b;
}

/* sets standard dark color for all general descriptive labels in form rows */
QLabel {
    color: #0f172a;
    font-weight: bold;
}

/* sets standard styling for text inputs, dropdown boxes, and date selectors */
QLineEdit, QComboBox, QDateEdit, QSpinBox, QTextEdit, QListWidget {
    background-color: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px;
    color: #0f172a;
}

/* changes the border color to TIP Gold when clicking or typing inside an input box */
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QTextEdit:focus, QListWidget:focus {
    border-color: #eab308;
}

/* sets white background and slate gray border for up/down arrow buttons inside spinbox */
QSpinBox::up-button, QSpinBox::down-button {
    background-color: white;
    border-left: 1px solid #cbd5e1;
    width: 16px;
}

/* darkens the arrow buttons inside the spinbox when pointed to */
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #e2e8f0;
}

/* forces popup list inside dropdown box to show dark text on white background */
QComboBox QAbstractItemView {
    background-color: white;
    color: #0f172a;
    selection-background-color: #eab308;
    selection-color: #0f172a;
}

/* sets dark charcoal background and white text for the item adding button */
QPushButton#addItemBtn {
    background-color: #334155;
    color: white;
    font-weight: bold;
    border-radius: 8px;
    padding: 8px;
    border: none;
}

/* darkens the item adding button when hovered */
QPushButton#addItemBtn:hover {
    background-color: #1e293b;
}

/* default light slate background for clear items button */
QPushButton#clearItemsBtn {
    background-color: #e2e8f0;
    color: #334155;
    font-weight: bold;
    border-radius: 8px;
    padding: 10px;
    border: none;
}

/* darkens the clear button on hover */
QPushButton#clearItemsBtn:hover {
    background-color: #cbd5e1;
}

/* sets TIP Gold background and dark text for submit request button */
QPushButton#submitRequestBtn {
    background-color: #eab308;
    color: #0f172a;
    font-weight: bold;
    border-radius: 8px;
    padding: 10px;
    border: none;
}

/* darkens the submit request button on hover */
QPushButton#submitRequestBtn:hover {
    background-color: #ca8a04;
}

/* sets styles for table grid background and outer borders */
QTableWidget {
    background-color: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    color: #0f172a;
}

/* sets TIP Black header background with TIP Gold text */
QHeaderView::section {
    background-color: #111827;
    color: #eab308;
    font-weight: 600;
    padding: 6px;
    border: none;
}