/* Custom industrial styling for stockroom physical inventory operations manager */
QWidget#StaffDashboard {
    background-color: #f8fafc;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #1e293b;
}

QLabel#pageTitle {
    font-size: 22px;
    font-weight: bold;
    color: #eab308;
}

QLabel#pageSubtitle {
    font-size: 12px;
    color: #334155;
}

QLabel#sectionLabel {
    font-weight: bold;
    color: #1e293b;
}

QLineEdit, QSpinBox {
    background-color: white;
    border: 2px solid #cbd5e1;
    border-radius: 6px;
    padding: 6px;
    color: #0f172a;
}

QLineEdit:focus, QSpinBox:focus {
    border-color: #eab308;
}

QPushButton#addStockBtn {
    background-color: #334155;
    color: white;
    font-weight: bold;
    border-radius: 6px;
    padding: 8px;
    border: none;
}

QPushButton#addStockBtn:hover {
    background-color: #1e293b;
}

QPushButton#releaseBtn {
    background-color: #eab308;
    color: #0f172a;
    font-weight: bold;
    border-radius: 6px;
    padding: 10px;
    border: none;
}

QPushButton#releaseBtn:hover {
    background-color: #ca8a04;
}

QTableWidget {
    background-color: white;
    border: 2px solid #cbd5e1;
    border-radius: 6px;
    color: #0f172a;
}

QHeaderView::section {
    background-color: #111827;
    color: #eab308;
    font-weight: 600;
    padding: 5px;
    border: none;
}